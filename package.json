{
  "name": "academic-research-skills-dsh",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness port of the Academic Research Skills plugin: 5 skills, 16 /ars-* commands, 4 agent roles, write-scope guard, and deterministic Python gates.",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "bin/**",
    "payload/**",
    "locale/*.json",
    "icon.svg",
    "requirements-runtime.txt",
    "README.md",
    "NOTICE.md",
    "ASSET-LICENSES.md",
    "UPGRADING.md",
    "LICENSE",
    "CITATION.cff",
    "docs/compat-report.md",
    "tools/**",
    "test/**"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:payload": "node tools/build-payload.mjs",
    "check:payload": "node tools/check-payload.mjs",
    "build:python-wrapper": "node tools/build-python-wrapper.mjs",
    "check:python-wrapper": "node tools/build-python-wrapper.mjs --check",
    "check:upstream": "node tools/check-upstream.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": {
    "name": "Guoqin Chen",
    "url": "https://github.com/guoqinchen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoqinchen/academic-research-skills-dsh.git"
  },
  "homepage": "https://github.com/guoqinchen/academic-research-skills-dsh#readme",
  "bugs": {
    "url": "https://github.com/guoqinchen/academic-research-skills-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "academic-research",
    "literature-review",
    "peer-review",
    "systematic-review",
    "research-automation"
  ],
  "os": [
    "darwin",
    "linux"
  ]
}
