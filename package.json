{
  "name": "academic-research-skills-dsh",
  "version": "2.1.1",
  "type": "module",
  "description": "Unofficial DeepSeek Harness port of the Academic Research Skills plugin (CC-BY-NC-4.0, non-commercial): 5 skills, 16 /ars-* commands, 4 agent roles, write-scope guard, and deterministic Python gates.",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "bin/**",
    "payload/**",
    "locale/*.json",
    "icon.svg",
    "requirements-runtime.txt",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "ASSET-LICENSES.md",
    "UPGRADING.md",
    "LICENSE",
    "CITATION.cff",
    "docs/compat-report.md",
    "docs/verification.md",
    "docs/third-party-audit.md",
    "docs/license-assessment.md",
    "docs/commercial-build.md",
    "tools/**",
    "test/**",
    "docs/jev-integrations.md",
    "docs/release-checklist.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:payload": "node tools/build-payload.mjs",
    "check:payload": "node tools/check-payload.mjs",
    "build:python-wrapper": "node tools/build-python-wrapper.mjs",
    "check:python-wrapper": "node tools/build-python-wrapper.mjs --check",
    "check:upstream": "node tools/check-upstream.mjs",
    "publish:github": "node tools/publish-github-package.mjs",
    "jev:citation": "node tools/jev-citation-support.mjs",
    "jev:screening": "node tools/jev-screening-assist.mjs",
    "jev:triage": "node tools/jev-upstream-triage.mjs",
    "check:release-parity": "node tools/check-release-parity.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": {
    "name": "Guoqin Chen",
    "url": "https://github.com/guoqinchen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoqinchen/academic-research-skills-dsh.git"
  },
  "homepage": "https://github.com/guoqinchen/academic-research-skills-dsh#readme",
  "bugs": {
    "url": "https://github.com/guoqinchen/academic-research-skills-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "academic-research",
    "literature-review",
    "peer-review",
    "systematic-review",
    "research-automation"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "private": false
}
